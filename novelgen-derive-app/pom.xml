<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.zzdzz</groupId>
    <artifactId>novelgen-server</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>novelgen-derive-app</artifactId>
  <name>novelgen-derive-app</name>
  <description>随机衍生系统启动壳（架构设计 D11/F 方案）：扫描白名单只装 derive + 共享基建，
    不加载 zzdzz 业务 Runner/服务（其 ApplicationReady 监听依赖 zzdzz 表，且新旧 novels 同名不同构）；
    连 derive_gen 库，与 novelgen-app（8090/novel_gen）互不干扰。</description>

  <dependencies>
    <dependency>
      <groupId>com.zzdzz</groupId>
      <artifactId>novelgen-common</artifactId>
    </dependency>
    <dependency>
      <groupId>com.zzdzz</groupId>
      <artifactId>novelgen-model</artifactId>
    </dependency>
    <dependency>
      <groupId>com.zzdzz</groupId>
      <artifactId>novelgen-data</artifactId>
    </dependency>
    <dependency>
      <groupId>com.zzdzz</groupId>
      <artifactId>novelgen-llm</artifactId>
    </dependency>
    <dependency>
      <groupId>com.zzdzz</groupId>
      <artifactId>novelgen-service</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
