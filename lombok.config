# Lombok 全局配置（2026-10-03）
#
# 31 个 XxxDO 都 extends BaseDO。Lombok 默认生成的 equals/hashCode **不调用父类实现**，
# 于是基类里的 id 会被静默排除在相等性比较之外——这与重构前（主键各自声明在子类里、
# 参与比较）语义不一致。callSuper=call 让生成的 equals/hashCode 把父类字段一起算进来。
lombok.equalsAndHashCode.callSuper = call

# 不再向上级目录冒泡查找 lombok.config，避免被仓库外/用户目录的配置意外覆盖。
config.stopBubbling = true
