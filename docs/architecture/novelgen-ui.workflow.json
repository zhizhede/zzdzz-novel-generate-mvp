{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "UI 操作流：六个用户任务 × 页面 × 缺口",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "viewBox": [
      1150,
      560
    ],
    "output": "ui-workflow.html"
  },
  "lanes": [
    {
      "id": "gen",
      "label": "生成侧"
    },
    {
      "id": "gate",
      "label": "质量侧",
      "variant": "exception"
    },
    {
      "id": "loop",
      "label": "闭环侧"
    }
  ],
  "groups": [
    {
      "id": "g_submit",
      "label": "任务① 提交生成",
      "lane": "gen",
      "fromCol": 0,
      "toCol": 2
    },
    {
      "id": "g_monitor",
      "label": "任务② 盯进度",
      "lane": "gen",
      "fromCol": 3,
      "toCol": 5,
      "variant": "dashed"
    },
    {
      "id": "g_approve",
      "label": "任务③ 审批",
      "lane": "gate",
      "fromCol": 0,
      "toCol": 2
    },
    {
      "id": "g_diagnose",
      "label": "任务④ 查失败原因",
      "lane": "gate",
      "fromCol": 3,
      "toCol": 5,
      "variant": "security"
    },
    {
      "id": "g_redo",
      "label": "任务⑤ 纠偏重跑",
      "lane": "loop",
      "fromCol": 0,
      "toCol": 2,
      "variant": "security"
    },
    {
      "id": "g_retro",
      "label": "任务⑥ 复盘与账本纠偏",
      "lane": "loop",
      "fromCol": 3,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "mainPath": [
    "wb",
    "run",
    "qok"
  ],
  "nodes": [
    {
      "id": "wb",
      "lane": "gen",
      "col": 0,
      "type": "frontend",
      "label": "工作台",
      "sublabel": "选书+章区间",
      "width": 132
    },
    {
      "id": "run",
      "lane": "gen",
      "col": 1,
      "type": "frontend",
      "label": "开始生成",
      "sublabel": "POST run·秒回任务号",
      "width": 132
    },
    {
      "id": "qok",
      "lane": "gen",
      "col": 2,
      "type": "messagebus",
      "label": "队列面板盯任务",
      "tag": "顺畅",
      "width": 132
    },
    {
      "id": "sse",
      "lane": "gen",
      "col": 3,
      "type": "frontend",
      "label": "日志面板 SSE",
      "sublabel": "事件逐条滚",
      "width": 132
    },
    {
      "id": "scenegap",
      "lane": "gen",
      "col": 4,
      "type": "frontend",
      "label": "进度只有章级",
      "sublabel": "场景级一闪而过",
      "tag": "粒度粗",
      "width": 132
    },
    {
      "id": "lane1",
      "lane": "gen",
      "col": 5,
      "type": "messagebus",
      "label": "全局单车道",
      "sublabel": "多任务排队无预期",
      "tag": "假异步真串行",
      "width": 132
    },
    {
      "id": "chpage",
      "lane": "gate",
      "col": 0,
      "type": "frontend",
      "label": "章节页",
      "sublabel": "点行开抽屉",
      "width": 132
    },
    {
      "id": "approvebtn",
      "lane": "gate",
      "col": 1,
      "type": "frontend",
      "label": "通过审批",
