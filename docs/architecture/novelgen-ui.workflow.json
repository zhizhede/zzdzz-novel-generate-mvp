  "cards": [
    {
      "dot": "cyan",
      "title": "图例读法",
      "items": [
        "每个小组=一个用户任务：在哪一屏→点什么→结果与缺口",
        "绿色主链=今天顺畅的路（只有提交生成一条）；红边+tag=缺口；虚线=目标态"
      ]
    },
    {
      "dot": "rose",
      "title": "四个没有终点的任务",
      "items": [
        "全新重生成：断点续跑冒充重跑，干净重来只能手工清库",
        "打回+意见：审批只有「通过」，人话意见进不了 replan",
        "复盘建议采纳：报告只读，单条采纳/拒绝无操作",
        "digest 后台进度：审批后干等，失败只回退状态不告诉你"
      ]
    },
    {
      "dot": "amber",
      "title": "一屏答案清单（目标）",
      "items": [
        "章详情一屏回答：走到哪步/为何失败/digest 进度/当时评审口径",
        "数据源=时序图契约②的状态行；入口深度随三图改造一并收敛"
      ]
    }
  ]
}