      "width": 132
    },
    {
      "id": "oneview",
      "lane": "gate",
      "col": 5,
      "type": "backend",
      "label": "章详情一屏",
      "sublabel": "状态+原因+digest",
      "tag": "目标·契约②",
      "width": 132
    },
    {
      "id": "chfailed",
      "lane": "loop",
      "col": 0,
      "type": "frontend",
      "label": "章节 FAILED",
      "sublabel": "详情抽屉里找按钮",
      "width": 132
    },
    {
      "id": "rerun",
      "lane": "loop",
      "col": 1,
      "type": "frontend",
      "label": "重新生成本章",
      "sublabel": "=断点续跑",
      "tag": "缺全新重生成",
      "width": 132
    },
    {
      "id": "chain3",
      "lane": "loop",
      "col": 2,
      "type": "security",
      "label": "清场→纠偏→重跑",
      "sublabel": "手工三步+另开规划页",
      "tag": "应一端点",
      "width": 132
    },
    {
      "id": "volbtn",
      "lane": "loop",
      "col": 3,
      "type": "frontend",
      "label": "规划页复盘按钮",
      "sublabel": "按卷触发",
      "width": 132
    },
    {
      "id": "dialog",
      "lane": "loop",
      "col": 4,
      "type": "frontend",
      "label": "报告对话框只读",
      "tag": "无采纳/拒绝",
      "width": 132
    },
    {
      "id": "ledger",
      "lane": "loop",
      "col": 5,
      "type": "database",
      "label": "素材库深处纠偏",
      "sublabel": "伏笔/世界状态",
      "tag": "埋两层",
      "width": 132
    }
  ],
