  "cards": [
    {
      "dot": "emerald",
      "title": "主路径（一条）",
      "items": [
        "提交生成 → DB 队列 → 单 worker 逐章执行",
        "章纲 → 场景生成 → 场景门禁 → 拼章 → 章级门禁 → 读者评审 → AI 审校 → 审批 → digest",
        "结果与进度经 pipeline_events 落库，SSE 实时推回浏览器"
      ]
    },
    {
      "dot": "cyan",
      "title": "四层记忆与三道闸",
      "items": [
        "记忆：素材卡（设定）· 事实账（事件，滚动 3 条）· 世界状态（时点）· 伏笔台账（长线）",
        "闸门：机械门禁（指纹/黑名单）→ 读者评审（注水率）→ AI 审校（BLOCKER 修一轮）；读者评审与 AI 审校同样经 LLM 网关调用模型",
        "失败自愈：重试 N1 次 → 换目标重写卷纲再试 N2 次（Tuning 可调）"
      ]
    },
    {
      "dot": "rose",
      "title": "信任边界",
      "items": [
        "边界 A：浏览器 ↔ 后端，JWT HttpOnly Cookie，重启不掉线",
        "边界 B：后端 ↔ MiniMax，API Key 仅存 application-local.yaml（gitignore），永不入库",
        "PostgreSQL 在本机 docker（pg-vector），仅后端可达；REST 读取章节/台账也由接入层直查数据库；embedding 模型 embo-01 已备价目，RAG 未上线"
      ]
    },
    {
      "dot": "amber",
      "title": "横切能力（见说明，不加连线）",
      "items": [
        "按节点模型路由与峰谷计费：14 个 LLM 节点独立路由，llm_call_log 全量台账（含 cached_tokens）",
        "StageLog 事件门面：15 类事件枚举收口，SSE + 流水双通道",
        "Tuning 调参中心：16 个行为参数在线可调（30s 生效）；错误码按阿里手册 A/B/C/D/E 五位分级"
      ]
    }
  ]
